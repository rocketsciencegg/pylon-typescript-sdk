# Supply-chain cooldown: refuse any package version published less than 24h ago.
#
# Mirrors beam's `minimumReleaseAge: 1440` (pnpm-workspace.yaml). The window is the point: most
# malicious publishes to npm are caught and yanked within hours, so simply not being first to install
# a brand-new version removes most of that exposure for free. If a genuinely urgent version is
# needed, pin it and wait the day out rather than removing the guard.
minimum-release-age=1440
